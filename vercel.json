{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/cache-originals.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/enviar-fotos.html"
    },
    {
      "source": "/api/album/:path*",
      "destination": "/api/album?albumPath=:path*"
    }
  ],
  "functions": {
    "api/photos.js": {
      "maxDuration": 60
    },
    "api/album.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/album-originals/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
